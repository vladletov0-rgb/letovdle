# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# Необязательно: ID сервера для мгновенной регистрации команды (удобно при разработке).
# Без него команда регистрируется глобально (появляется в течение ~часа).
GUILD_ID=
# Часовой пояс, по которому меняется слово дня
WORDLE_TZ=Europe/Moscow
